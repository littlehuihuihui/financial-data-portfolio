{
  "title": "有效播放完播率主题（示例填法）",
  "industry": "internet",
  "business_process": "点播播放行为，服务内容运营周会完播监控",
  "grain": "DWD一行=一次播放；DWS=日×剧集",
  "success_criteria": "工作日09:00可看昨日完播率，可按series_id下钻",
  "tables": {
    "ods": ["ods_log_vod_di"],
    "dim": ["dim_content_series", "dim_device"],
    "dwd": ["dwd_vod_play_di"],
    "dws": ["dws_content_series_play_1d"],
    "ads": ["v_vod_finish_rate"]
  },
  "ads_notes": "v_vod_finish_rate 为拟新增；现网04_ott_ads_views.sql无此视图",
  "metrics": [
    {
      "name": "完播率",
      "formula": "finish_cnt / NULLIF(vv,0)",
      "source_layer": "ADS",
      "atoms": ["finish_cnt", "vv"]
    }
  ],
  "dq": [
    "is_finish IN (0,1)",
    "finish_cnt <= vv",
    "mac 可关联 dim_device"
  ],
  "sla": "T+1 09:00 昨日分区可用",
  "risks": ["seed_ott 原始日志仅近3天，更早明细可能缺失"]
}
